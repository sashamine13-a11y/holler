# Holler environment variables
# Copy to .env and fill in your values

# Server-side (NOT exposed to client) — for dynamic hosting (Vercel, Render, Railway)
CLASS_CODE=519284
ADMIN_CODE=836471

# Client-side (exposed to browser, safe to share)
# Required for real-time. Get free key at https://ably.com
NEXT_PUBLIC_ABLY_KEY=your_ably_client_api_key

# For Cloudflare Pages static hosting, also set these as NEXT_PUBLIC_* vars:
# NEXT_PUBLIC_CLASS_CODE=519284
# NEXT_PUBLIC_ADMIN_CODE=836471
