# Holler environment variables
# Copy to .env and fill in your values

# Server-side (NOT exposed to client) — for dynamic hosting (Vercel, Render, Railway)
CLASS_CODE=519284
ADMIN_CODE=836471

# Client-side (exposed to browser, safe to share)

# Ably (real-time messaging) — required for real-time
# Get free key at https://ably.com
NEXT_PUBLIC_ABLY_KEY=your_ably_client_api_key

# Supabase (authentication) — required for email/password + Google OAuth
# Get free keys at https://app.supabase.com → New Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# For Cloudflare Pages / GitHub Pages static hosting, also set these as NEXT_PUBLIC_* vars:
# NEXT_PUBLIC_CLASS_CODE=519284
# NEXT_PUBLIC_ADMIN_CODE=836471
